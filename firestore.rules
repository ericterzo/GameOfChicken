rules_version = '2';

// The game's rules are computed in the app (src/game/rules.ts). These rules
// stop outsiders and obvious tampering: only members can change a yard, the
// yard's settings never change, nobody can start a meal for someone else, and
// a finished yard's scores are frozen. They do not re-check every point, so a
// determined member with developer tools could still cheat; a Cloud Function
// would be needed to close that completely.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function nowMs() { return request.time.toMillis(); }
    function fortnight() { return 14 * 24 * 3600 * 1000; }
    function slack() { return 5 * 60 * 1000; } // tolerated phone clock error

    match /usernames/{name} {
      // Anyone may check whether one name is taken (needed before signing up);
      // only signed-in players may browse.
      allow get: if true;
      allow list: if signedIn();
      // A name is claimed once, for good (create only: an existing one can never be
      // overwritten), together with the profile that uses it. Names are stored in
      // lower case, so "Anna" and "anna" are the same name.
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid', 'login'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username.lower() == name;
      // A name is released only by its holder, and only when they stop using it:
      // on renaming (the profile now carries another name) or deleting the account.
      allow delete: if signedIn()
        && resource.data.uid == me()
        && (!existsAfter(/databases/$(database)/documents/users/$(me()))
            || getAfter(/databases/$(database)/documents/users/$(me())).data.username.lower() != name);
    }

    match /users/{uid} {
      allow read: if signedIn();
      // A profile can only carry a username its owner holds in the register above.
      allow create: if signedIn() && uid == me()
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == me()
        && request.resource.data.stats.gamesPlayed == 0
        && request.resource.data.stats.wins == 0;
      // Renaming is allowed only to a name its owner holds in the register.
      allow update: if signedIn() && uid == me()
        && (request.resource.data.username == resource.data.username
            || (getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == me()
                // ...and the old name is released in the same step (unless only the capitals changed).
                && (request.resource.data.username.lower() == resource.data.username.lower()
                    || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username.lower())))));
      // When a yard closes, any member adds its result to every member's record:
      // only that, only once per yard (the yard notes who has been counted, in the
      // same step), and only what the yard's final scores say.
      function claimYard() { return get(/databases/$(database)/documents/yards/$(request.resource.data.claimedYard)).data; }
      function claimYardAfter() { return getAfter(/databases/$(database)/documents/yards/$(request.resource.data.claimedYard)).data; }
      allow update: if signedIn() && uid != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'claimedYard'])
        && claimYard().status == 'finished'
        && claimYard().memberUids.size() >= 2
        && me() in claimYard().memberUids
        && uid in claimYard().memberUids
        && claimYard().members[uid].statsClaimed != true
        && !(uid in claimYard().get('claimedUids', []))
        && uid in claimYardAfter().claimedUids
        && request.resource.data.stats.gamesPlayed == resource.data.stats.gamesPlayed + 1
        && request.resource.data.stats.wins == resource.data.stats.wins + (uid in claimYard().winnerUids ? 1 : 0)
        && request.resource.data.stats.totalPoints == resource.data.stats.totalPoints + claimYard().members[uid].points;
      // Deleting the account must release its name in the same step.
      allow delete: if signedIn() && uid == me()
        && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username.lower()));

      match /inbox/{id} {
        allow read, update, delete: if signedIn() && uid == me();
        allow create: if signedIn()
          && request.resource.data.byUid == me()
          && request.resource.data.read == false;
      }
    }

    match /yards/{yardId} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function changed() { return after().diff(before()).affectedKeys(); }
      function isMember() { return me() in before().memberUids; }

      function settingsUnchanged() {
        return changed().hasOnly(['status', 'winnerUids', 'eating', 'members', 'memberUids',
                                  'invitedUids', 'declinedUids', 'createdAt', 'endsAt', 'claimedUids'])
          && clockOk()
          && !(after().status == 'waiting' && before().status != 'waiting');
      }
      // The clock only moves once: when a waiting yard starts, it keeps its length.
      function clockOk() {
        return (after().createdAt == before().createdAt && after().endsAt == before().endsAt)
          || (before().status == 'waiting' && after().status == 'active'
              && after().endsAt - after().createdAt == before().endsAt - before().createdAt
              && after().createdAt > nowMs() - slack() && after().createdAt < nowMs() + slack());
      }
      // An invited player who is not a member may only take themselves off the list.
      function declining() {
        return !isMember()
          && me() in before().invitedUids
          && changed().hasOnly(['invitedUids', 'declinedUids', 'status', 'createdAt', 'endsAt'])
          && after().invitedUids == before().invitedUids.removeAll([me()])
          && after().declinedUids == before().declinedUids.concat([me()]);
      }

      // A brand new meal (not just a heartbeat on the current one).
      function startsMeal() {
        return after().eating != null
          && (before().eating == null || after().eating.startedAt != before().eating.startedAt);
      }
      function mealOk() {
        return !startsMeal() || (
          after().eating.uid == me()
          && after().eating.startedAt > nowMs() - slack()
          && after().eating.startedAt < nowMs() + slack()
          && (after().hardcore
              ? after().eating.endsAt == null
              : after().eating.endsAt > after().eating.startedAt && after().eating.endsAt <= after().endsAt)
        );
      }

      function memberMove() {
        return isMember() && after().memberUids == before().memberUids;
      }
      function joining() {
        return !isMember()
          && before().status != 'finished'
          && before().memberUids.size() < 12
          && after().memberUids == before().memberUids.concat([me()])
          && after().members.diff(before().members).affectedKeys().hasOnly([me()])
          && after().members[me()].points == 0
          && !startsMeal();
      }
      // Once finished, a member may only touch their own entry, never scores.
      // Who has had the result added to their record: only noted once the yard is
      // over, and names are never taken off the list.
      function claimsOk() {
        return after().get('claimedUids', []) == before().get('claimedUids', [])
          || (before().status == 'finished' && after().claimedUids.hasAll(before().get('claimedUids', [])));
      }
      function frozenOk() {
        return before().status != 'finished' || (
          after().status == 'finished'
          && after().winnerUids == before().winnerUids
          && after().eating == null
          && after().members.diff(before().members).affectedKeys().hasOnly([me()])
          && after().members[me()].points == before().members[me()].points
        );
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && after().ownerUid == me()
        && after().memberUids == [me()]
        && after().members.keys().hasOnly([me()])
        && after().members[me()].points == 0
        && after().status in ['active', 'waiting']
        && after().eating == null
        && after().winnerUids.size() == 0
        && after().name is string && after().name.size() > 0 && after().name.size() <= 30
        && after().mode in ['lastGrain', 'sundown', 'fatHen']
        && (after().mode == 'sundown' ? after().goal == null : after().goal >= 10)
        && after().hardcore is bool
        && (!after().hardcore || after().sleep == null)
        && after().createdAt > nowMs() - slack() && after().createdAt < nowMs() + slack()
        && after().endsAt > nowMs()
        && after().endsAt <= nowMs() + fortnight() + slack();

      allow update: if signedIn()
        && settingsUnchanged()
        && (memberMove() || joining() || declining())
        && mealOk()
        && frozenOk()
        && claimsOk();

      // The yard's notice board: notes from members and a log of what happened.
      // Lines are only ever added, by members, in their own name and not post-dated.
      match /board/{entryId} {
        function entry() { return request.resource.data; }
        allow read: if signedIn()
          && me() in get(/databases/$(database)/documents/yards/$(yardId)).data.memberUids;
        allow create: if signedIn()
          && me() in getAfter(/databases/$(database)/documents/yards/$(yardId)).data.memberUids
          && entry().by == me()
          && entry().at is number && entry().at < nowMs() + slack()
          && entry().username is string
          && (
            (entry().kind == 'chat'
              && entry().keys().hasOnly(['kind', 'at', 'by', 'uid', 'username', 'text'])
              && entry().uid == me() && entry().at > nowMs() - slack()
              && entry().text is string && entry().text.size() > 0 && entry().text.size() <= 300)
            || (entry().kind == 'visit'
              && entry().keys().hasOnly(['kind', 'at', 'by', 'uid', 'username'])
              && entry().uid == me() && entry().at > nowMs() - slack())
            || (entry().kind == 'ate'
              && entry().keys().hasOnly(['kind', 'at', 'by', 'uid', 'username', 'amount']))
            || (entry().kind == 'caught'
              && entry().keys().hasOnly(['kind', 'at', 'by', 'uid', 'username', 'victimUid', 'victimName', 'lost', 'taken'])
              && entry().uid == me())
          );
      }
    }
  }
}
